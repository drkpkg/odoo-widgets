<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_map_view_form" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.map</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information']/group/group[1]" position="after">
                <group string="Location">
                    <field name="map_location" widget="location_map" nolabel="1" colspan="2"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
